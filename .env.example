DATA_DIR=data
SECRETS_DIR=secrets
BACKUP_DIR=data/backups
APP_BIND=127.0.0.1
APP_PORT=8765
APP_BASE_URL=http://127.0.0.1:8765
APP_TIMEZONE=America/Argentina/Buenos_Aires
# false only for loopback development over HTTP. Use HTTPS and true for LAN deployment.
COOKIE_SECURE=false

# Corpus público de la demo; almacenamiento separado de producción
DEMO_CORPUS_DIR=demo-corpus

# Lightweight, fictional public demo; no collector or external services.
DEMO_SHOWCASE=true
DEFAULT_LANGUAGE=en
AI_INTERNAL_HOSTS=
COLLABORATION_ENABLED=true
